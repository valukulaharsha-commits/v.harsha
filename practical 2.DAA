#include <iostream>
#include <vector>
#include <chrono>
#include <cstdlib>

using namespace std;
using namespace chrono;

/* ================= FACTORIAL ================= */

unsigned long long factIter(int n) {
    unsigned long long res = 1;
    for(int i = 1; i <= n; i++)
        res *= i;
    return res;
}

unsigned long long factRec(int n) {
    if(n <= 1) return 1;
    return n * factRec(n - 1);
}

/* ================= SEARCH ================= */

int linearSearch(const vector<int>& arr, int key) {
    for(int i = 0; i < arr.size(); i++)
        if(arr[i] == key) return i;
    return -1;
}

int binarySearch(const vector<int>& arr, int key) {
    int low = 0, high = arr.size() - 1;
    while(low <= high) {
        int mid = low + (high - low) / 2;
        if(arr[mid] == key) return mid;
        else if(arr[mid] < key) low = mid + 1;
        else high = mid - 1;
    }
    return -1;
}

/* ================= SORTING ================= */

void bubbleSort(vector<int>& a) {
    for(int i = 0; i < a.size(); i++)
        for(int j = 0; j < a.size()-i-1; j++)
            if(a[j] > a[j+1])
                swap(a[j], a[j+1]);
}

void selectionSort(vector<int>& a) {
    for(int i = 0; i < a.size(); i++) {
        int minIdx = i;
        for(int j = i+1; j < a.size(); j++)
            if(a[j] < a[minIdx])
                minIdx = j;
        swap(a[i], a[minIdx]);
    }
}

void insertionSort(vector<int>& a) {
    for(int i = 1; i < a.size(); i++) {
        int key = a[i], j = i - 1;
        while(j >= 0 && a[j] > key) {
            a[j+1] = a[j];
            j--;
        }
        a[j+1] = key;
    }
}

/* ================= MAIN ================= */

int main() {
    int choice;

    do {
        cout << "\n===== MENU =====\n";
        cout << "1. Factorial\n";
        cout << "2. Searching (Linear & Binary)\n";
        cout << "3. Sorting\n";
        cout << "0. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        /* -------- FACTORIAL -------- */
        if(choice == 1) {
            int n;
            cout << "Enter number: ";
            cin >> n;

            unsigned long long r1, r2;

            auto start = high_resolution_clock::now();
            r1 = factIter(n);
            auto end = high_resolution_clock::now();
            double t1 = duration<double, nano>(end - start).count();

            start = high_resolution_clock::now();
            r2 = factRec(n);
            end = high_resolution_clock::now();
            double t2 = duration<double, nano>(end - start).count();

            cout << "\nIterative Result: " << r1;
            cout << "\nTime: " << t1 << " ns\n";

            cout << "Recursive Result: " << r2;
            cout << "\nTime: " << t2 << " ns\n";
        }

        /* -------- SEARCH -------- */
        else if(choice == 2) {
            const int SIZE = 100000;
            vector<int> arr(SIZE);

            for(int i = 0; i < SIZE; i++)
                arr[i] = i + 1;

            int key;
            cout << "Enter value to search: ";
            cin >> key;

            int pos;

            auto start = high_resolution_clock::now();
            pos = linearSearch(arr, key);
            auto end = high_resolution_clock::now();

            cout << "\n--- Linear Search ---\n";
            cout << (pos != -1 ? "Found at index: " + to_string(pos) : "Not Found") << endl;
            cout << "Time: "
                 << duration_cast<microseconds>(end - start).count()
                 << " microseconds\n";

            start = high_resolution_clock::now();
            pos = binarySearch(arr, key);
            end = high_resolution_clock::now();

            cout << "\n--- Binary Search ---\n";
            cout << (pos != -1 ? "Found at index: " + to_string(pos) : "Not Found") << endl;
            cout << "Time: "
                 << duration_cast<microseconds>(end - start).count()
                 << " microseconds\n";
        }

        /* -------- SORTING -------- */
        else if(choice == 3) {
            const int SIZE = 100;
            vector<int> data(SIZE);

            for(int i = 0; i < SIZE; i++)
                data[i] = rand() % 5000;

            vector<int> temp;

            cout << "\nSorting " << SIZE << " elements...\n";

            temp = data;
            auto start = high_resolution_clock::now();
            bubbleSort(temp);
            auto end = high_resolution_clock::now();
            cout << "Bubble Sort: "
                 << duration_cast<microseconds>(end - start).count()
                 << " microseconds\n";

            temp = data;
            start = high_resolution_clock::now();
            selectionSort(temp);
            end = high_resolution_clock::now();
            cout << "Selection Sort: "
                 << duration_cast<microseconds>(end - start).count()
                 << " microseconds\n";

            temp = data;
            start = high_resolution_clock::now();
            insertionSort(temp);
            end = high_resolution_clock::now();
            cout << "Insertion Sort: "
                 << duration_cast<microseconds>(end - start).count()
                 << " microseconds\n";
        }

    } while(choice != 0);

    return 0;
}
