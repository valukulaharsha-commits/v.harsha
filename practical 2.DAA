#include <iostream>
using namespace std;

// ---------- Linear Search ----------
int linearSearch(int arr[], int n, int key) {
    for(int i = 0; i < n; i++) {
        if(arr[i] == key)
            return i; // found
    }
    return -1; // not found
}

// ---------- Binary Search (Iterative) ----------
int binarySearch(int arr[], int n, int key) {
    int low = 0, high = n - 1;

    while(low <= high) {
        int mid = (low + high) / 2;

        if(arr[mid] == key)
            return mid;
        else if(arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }
    return -1;
}

// ---------- Main ----------
int main() {
    int arr[] = {2, 4, 6, 8, 10, 12};
    int n = sizeof(arr)/sizeof(arr[0]);
    int key = 8;

    // Linear Search
    int lin = linearSearch(arr, n, key);
    if(lin != -1)
        cout << "Linear Search: Found at index " << lin << endl;
    else
        cout << "Linear Search: Not Found\n";

    // Binary Search
    int bin = binarySearch(arr, n, key);
    if(bin != -1)
        cout << "Binary Search: Found at index " << bin << endl;
    else
        cout << "Binary Search: Not Found\n";

    return 0;
}
