#include <iostream>
#include <vector>
#include <chrono>
#include <cstdlib>

using namespace std;
using namespace chrono;

/* ---------- FACTORIAL ---------- */

// Iterative
unsigned long long factLoop(int n) {
    unsigned long long ans = 1;
    for (int i = 1; i <= n; i++) {
        ans *= i;
    }
    return ans;
}

// Recursive
unsigned long long factRec(int n) {
    if (n <= 1) return 1;
    return n * factRec(n - 1);
}

/* ---------- SEARCH ---------- */

// Linear Search
int linearSearch(const vector<int>& arr, int key) {
    for (int i = 0; i < arr.size(); i++) {
        if (arr[i] == key) return i;
    }
    return -1;
}

// Binary Search
int binarySearch(const vector<int>& arr, int key) {
    int low = 0, high = arr.size() - 1;

    while (low <= high) {
        int mid = (low + high) / 2;

        if (arr[mid] == key) return mid;
        else if (arr[mid] < key) low = mid + 1;
        else high = mid - 1;
    }
    return -1;
}

/* ---------- SORTING ---------- */

// Bubble
void bubbleSort(vector<int>& arr) {
    for (int i = 0; i < arr.size(); i++) {
        for (int j = 0; j < arr.size() - i - 1; j++) {
            if (arr[j] > arr[j + 1])
                swap(arr[j], arr[j + 1]);
        }
    }
}

// Selection
void selectionSort(vector<int>& arr) {
    for (int i = 0; i < arr.size(); i++) {
        int minIdx = i;
        for (int j = i + 1; j < arr.size(); j++) {
            if (arr[j] < arr[minIdx])
                minIdx = j;
        }
        swap(arr[i], arr[minIdx]);
    }
}

// Insertion
void insertionSort(vector<int>& arr) {
    for (int i = 1; i < arr.size(); i++) {
        int val = arr[i];
        int j = i - 1;

        while (j >= 0 && arr[j] > val) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = val;
    }
}

// Merge Helper
void mergeArr(vector<int>& arr, int l, int m, int r) {
    vector<int> left(arr.begin() + l, arr.begin() + m + 1);
    vector<int> right(arr.begin() + m + 1, arr.begin() + r + 1);

    int i = 0, j = 0, k = l;

    while (i < left.size() && j < right.size()) {
        if (left[i] <= right[j]) arr[k++] = left[i++];
        else arr[k++] = right[j++];
    }

    while (i < left.size()) arr[k++] = left[i++];
    while (j < right.size()) arr[k++] = right[j++];
}

// Merge Sort
void mergeSort(vector<int>& arr, int l, int r) {
    if (l >= r) return;

    int mid = (l + r) / 2;
    mergeSort(arr, l, mid);
    mergeSort(arr, mid + 1, r);
    mergeArr(arr, l, mid, r);
}

// Partition
int partitionArr(vector<int>& arr, int low, int high) {
    int pivot = arr[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (arr[j] < pivot) {
            i++;
            swap(arr[i], arr[j]);
        }
    }
    swap(arr[i + 1], arr[high]);
    return i + 1;
}

// Quick Sort
void quickSort(vector<int>& arr, int low, int high) {
    if (low < high) {
        int p = partitionArr(arr, low, high);
        quickSort(arr, low, p - 1);
        quickSort(arr, p + 1, high);
    }
}

/* ---------- MAIN ---------- */

int main() {

    // -------- Factorial --------
    int n = 10;
    unsigned long long res1, res2;

    auto t1 = high_resolution_clock::now();
    res1 = factLoop(n);
    auto t2 = high_resolution_clock::now();

    auto t3 = high_resolution_clock::now();
    res2 = factRec(n);
    auto t4 = high_resolution_clock::now();

    cout << "Factorial of " << n << endl;
    cout << "Iterative: " << res1 << " | Time: "
         << duration_cast<nanoseconds>(t2 - t1).count() << " ns\n";
    cout << "Recursive: " << res2 << " | Time: "
         << duration_cast<nanoseconds>(t4 - t3).count() << " ns\n\n";

    // -------- Search --------
    vector<int> arr(100000);
    for (int i = 0; i < arr.size(); i++) arr[i] = i + 1;

    int key = 55555;

    auto s1 = high_resolution_clock::now();
    int idx1 = linearSearch(arr, key);
    auto s2 = high_resolution_clock::now();

    auto s3 = high_resolution_clock::now();
    int idx2 = binarySearch(arr, key);
    auto s4 = high_resolution_clock::now();

    cout << "Linear Search Index: " << idx1
         << " | Time: " << duration_cast<microseconds>(s2 - s1).count() << " us\n";

    cout << "Binary Search Index: " << idx2
         << " | Time: " << duration_cast<microseconds>(s4 - s3).count() << " us\n\n";

    // -------- Sorting --------
    vector<int> data(100);
    for (int i = 0; i < 100; i++) data[i] = rand() % 1000;

    vector<int> temp;

    auto runSort = [&](auto func, string name) {
        temp = data;
        auto start = high_resolution_clock::now();
        func(temp);
        auto end = high_resolution_clock::now();

        cout << name << " Time: "
             << duration_cast<microseconds>(end - start).count()
             << " us\n";
    };

    runSort(bubbleSort, "Bubble");
    runSort(selectionSort, "Selection");
    runSort(insertionSort, "Insertion");

    temp = data;
    auto m1 = high_resolution_clock::now();
    mergeSort(temp, 0, temp.size() - 1);
    auto m2 = high_resolution_clock::now();
    cout << "Merge Time: "
         << duration_cast<microseconds>(m2 - m1).count() << " us\n";

    temp = data;
    auto q1 = high_resolution_clock::now();
    quickSort(temp, 0, temp.size() - 1);
    auto q2 = high_resolution_clock::now();
    cout << "Quick Time: "
         << duration_cast<microseconds>(q2 - q1).count() << " us\n";

    return 0;
}
